{
  "@schema": "π-compressed-glyph-v1",
  "@description": "K'UHUL π-Compressed Glyph Streaming Architecture",
  "@magic": ["0xCF", "0x80"],
  "@constants": {
    "π": 3.141592653589793,
    "e": 2.718281828459045,
    "φ": 1.618033988749895,
    "τ": 6.283185307179586
  },

  "categories": {
    "flow": {
      "description": "Control flow glyphs",
      "range": [0, 31],
      "glyphs": {
        "→": { "id": 0, "name": "flow_right", "pi_encode": "π×0" },
        "←": { "id": 1, "name": "flow_left", "pi_encode": "e×0.37" },
        "↑": { "id": 2, "name": "flow_up", "pi_encode": "φ×1.24" },
        "↓": { "id": 3, "name": "flow_down", "pi_encode": "τ×0.48" },
        "⟁": { "id": 4, "name": "atomic", "pi_encode": "π×1.27" },
        "⇄": { "id": 5, "name": "bidirectional", "pi_encode": "e×1.84" },
        "↻": { "id": 6, "name": "cycle", "pi_encode": "φ×3.71" },
        "⊛": { "id": 7, "name": "parallel", "pi_encode": "τ×1.11" }
      }
    },

    "value": {
      "description": "Value type glyphs",
      "range": [32, 63],
      "glyphs": {
        "∅": { "id": 32, "name": "null", "pi_encode": "π×10.19" },
        "⊤": { "id": 33, "name": "true", "pi_encode": "e×12.14" },
        "⊥": { "id": 34, "name": "false", "pi_encode": "φ×21.01" },
        "∞": { "id": 35, "name": "infinity", "pi_encode": "τ×5.57" },
        "℘": { "id": 36, "name": "state", "pi_encode": "π×11.46" },
        "Σ": { "id": 37, "name": "sum", "pi_encode": "e×13.61" },
        "Δ": { "id": 38, "name": "delta", "pi_encode": "φ×23.49" },
        "Ω": { "id": 39, "name": "omega", "pi_encode": "τ×6.21" }
      }
    },

    "action": {
      "description": "Action glyphs",
      "range": [64, 95],
      "glyphs": {
        "⚡": { "id": 64, "name": "execute", "pi_encode": "π×20.37" },
        "🔄": { "id": 65, "name": "refresh", "pi_encode": "e×23.91" },
        "💾": { "id": 66, "name": "save", "pi_encode": "φ×40.78" },
        "📤": { "id": 67, "name": "export", "pi_encode": "τ×10.66" },
        "🎯": { "id": 68, "name": "target", "pi_encode": "π×21.65" },
        "🔗": { "id": 69, "name": "link", "pi_encode": "e×25.38" },
        "⚙": { "id": 70, "name": "config", "pi_encode": "φ×43.26" },
        "🗑": { "id": 71, "name": "delete", "pi_encode": "τ×11.30" }
      }
    },

    "control": {
      "description": "Control operator glyphs",
      "range": [96, 127],
      "glyphs": {
        "Pop": { "id": 96, "name": "function_def", "pi_encode": "π×30.56" },
        "Wo": { "id": 97, "name": "value_emit", "pi_encode": "e×35.68" },
        "Ch'en": { "id": 98, "name": "bind", "pi_encode": "φ×60.55" },
        "Sek": { "id": 99, "name": "transform", "pi_encode": "τ×15.76" },
        "Xul": { "id": 100, "name": "scope_end", "pi_encode": "π×31.83" },
        "@state": { "id": 101, "name": "state_ref", "pi_encode": "e×37.15" },
        "@then": { "id": 102, "name": "continuation", "pi_encode": "φ×63.03" },
        "@loop": { "id": 103, "name": "iteration", "pi_encode": "τ×16.40" }
      }
    },

    "svg": {
      "description": "SVG-3D vector glyphs",
      "range": [128, 191],
      "glyphs": {
        "M": { "id": 128, "name": "move_to", "pi_encode": "π×40.74" },
        "L": { "id": 129, "name": "line_to", "pi_encode": "e×47.45" },
        "C": { "id": 130, "name": "cubic_bezier", "pi_encode": "φ×80.33" },
        "Q": { "id": 131, "name": "quad_bezier", "pi_encode": "τ×20.85" },
        "A": { "id": 132, "name": "arc", "pi_encode": "π×42.02" },
        "Z": { "id": 133, "name": "close_path", "pi_encode": "e×48.92" },
        "H": { "id": 134, "name": "horizontal", "pi_encode": "φ×82.81" },
        "V": { "id": 135, "name": "vertical", "pi_encode": "τ×21.49" },
        "S": { "id": 136, "name": "smooth_cubic", "pi_encode": "π×43.29" },
        "T": { "id": 137, "name": "smooth_quad", "pi_encode": "e×50.38" }
      }
    },

    "math": {
      "description": "Mathematical operation glyphs",
      "range": [192, 223],
      "glyphs": {
        "+": { "id": 192, "name": "add", "pi_encode": "π×61.11" },
        "-": { "id": 193, "name": "subtract", "pi_encode": "e×70.99" },
        "*": { "id": 194, "name": "multiply", "pi_encode": "φ×119.86" },
        "/": { "id": 195, "name": "divide", "pi_encode": "τ×30.76" },
        "^": { "id": 196, "name": "power", "pi_encode": "π×62.39" },
        "√": { "id": 197, "name": "sqrt", "pi_encode": "e×72.46" },
        "∫": { "id": 198, "name": "integral", "pi_encode": "φ×122.34" },
        "∂": { "id": 199, "name": "partial", "pi_encode": "τ×31.40" },
        "sin": { "id": 200, "name": "sine", "pi_encode": "π×63.66" },
        "cos": { "id": 201, "name": "cosine", "pi_encode": "e×73.92" }
      }
    },

    "stream": {
      "description": "Streaming control glyphs",
      "range": [224, 247],
      "glyphs": {
        "⏵": { "id": 224, "name": "play", "pi_encode": "π×71.30" },
        "⏸": { "id": 225, "name": "pause", "pi_encode": "e×82.76" },
        "⏹": { "id": 226, "name": "stop", "pi_encode": "φ×139.64" },
        "⏪": { "id": 227, "name": "rewind", "pi_encode": "τ×36.13" },
        "⏩": { "id": 228, "name": "forward", "pi_encode": "π×72.57" },
        "🔁": { "id": 229, "name": "loop", "pi_encode": "e×84.23" },
        "📊": { "id": 230, "name": "metrics", "pi_encode": "φ×142.12" },
        "🌊": { "id": 231, "name": "wave", "pi_encode": "τ×36.77" }
      }
    },

    "special": {
      "description": "Special control glyphs",
      "range": [248, 255],
      "glyphs": {
        "π-MAGIC": { "id": 248, "name": "magic_header", "bytes": ["0xCF", "0x80"] },
        "π-EOF": { "id": 249, "name": "end_of_frame" },
        "π-EOS": { "id": 250, "name": "end_of_stream" },
        "π-SYNC": { "id": 251, "name": "sync_point" },
        "π-KEY": { "id": 252, "name": "keyframe" },
        "π-DELTA": { "id": 253, "name": "delta_frame" },
        "π-INTERP": { "id": 254, "name": "interpolate" },
        "π-EXT": { "id": 255, "name": "extension" }
      }
    }
  },

  "encoding": {
    "header": {
      "magic": ["0xCF", "0x80"],
      "version": "uint8",
      "flags": "uint8",
      "frame_count": "uint16",
      "glyph_table_offset": "uint32"
    },
    "frame": {
      "timestamp_pi": "float32",
      "glyph_count": "uint16",
      "glyphs": "glyph[]"
    },
    "glyph": {
      "id": "uint8",
      "x_delta": "int16",
      "y_delta": "int16",
      "z_delta": "int16",
      "scale_pi": "uint8",
      "rotation_pi": "uint8"
    }
  },

  "svg3d": {
    "coordinate_system": "right_handed",
    "unit": "pi_units",
    "precision": 6,
    "interpolation": ["linear", "bezier", "catmull_rom", "hermite"],
    "transform_order": ["translate", "rotate", "scale"]
  }
}
