# ASX Runtime Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================

# Local Ollama host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Default model for local inference
OLLAMA_MODEL=llama3.2

# Cloud API key (get from https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# Enable cloud mode (true/false)
OLLAMA_USE_CLOUD=false

# Cloud model (used when OLLAMA_USE_CLOUD=true)
OLLAMA_CLOUD_MODEL=gpt-oss:120b

# =============================================================================
# ADDITIONAL AI PROVIDERS (Optional)
# =============================================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_HOST=https://api.deepseek.com

# Groq (fast inference)
GROQ_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# HuggingFace
HF_TOKEN=
HF_API_KEY=

# =============================================================================
# ASX API SERVER
# =============================================================================

# API server port
API_PORT=8000

# API server host
API_HOST=0.0.0.0

# Enable debug mode
DEBUG=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# =============================================================================
# CLUSTER CONFIGURATION
# =============================================================================

# Cluster server port
CLUSTER_PORT=3000

# Number of workers
CLUSTER_WORKERS=4

# Enable GPU acceleration
USE_GPU=true

# =============================================================================
# DATABASE & STORAGE
# =============================================================================

# Redis URL (for caching)
REDIS_URL=redis://localhost:6379

# Storage path for models
MODELS_PATH=./models

# =============================================================================
# SECURITY
# =============================================================================

# API authentication secret
API_SECRET=

# Rate limit (requests per minute)
RATE_LIMIT=60

# =============================================================================
# LOGGING
# =============================================================================

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/asx.log
