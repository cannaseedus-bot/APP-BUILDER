  "🚀LM_WORKFLOW_EXAMPLES": {
    "example_lm_1_unigram_bigram_trigram": {
      "prompt": "Create MX2LM @GRAM model using unigram+bigram+trigram from this corpus.",
      "workflow": [
        "1. User hits /micro/job with domain=lm_models and corpus_id specified.",
        "2. agent.corpus_curator validates corpus → builder.corpus_spec updates corpora table.",
        "3. agent.tokenizer designs tokenizer → builder.vocab + builder.tokenizer_config.",
        "4. agent.ngram requests @unigram, @bigram, @trigram → builder.ngram_table builds 3 tables.",
        "5. builder.ngram_stats computes entropy and metrics for each @GRAM level.",
        "6. agent.lm_architect defines LM config over these 3 @GRAM levels via builder.lm_config.",
        "7. agent.trainer defines checkpoint schedule via builder.checkpoint_manifest.",
        "8. Job returns model_id, tokenizer_id, gram_ids, checkpoint_plan."
      ]
    },

    "example_lm_2_glyphgram_symbolic": {
      "prompt": "Build symbolic GLYPHGRAM model over my existing MX2LM checkpoints.",
      "workflow": [
        "1. User submits domain=lm_models with gram_levels including '@glyphgram'.",
        "2. agent.ngram extends existing grams with glyph-level abstractions.",
        "3. builder.ngram_table builds glyphgram table from existing checkpoints and vocab.",
        "4. builder.ngram_stats evaluates glyphgram entropy and structure.",
        "5. agent.lm_architect updates LM config to include glyphgram attention/head routing.",
        "6. agent.trainer drafts fine-tune plan on glyphgram transitions only.",
        "7. Job returns updated model config and new checkpoint manifest entry."
      ]
    }
  }
