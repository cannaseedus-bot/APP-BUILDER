{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mx2lm.app/schemas/config.schema.json",
  "title": "MX2 Atomic User Environment Config Schema",
  "description": "The constitutional enforcement schema for MX2⟁☣ Atomic systems. Validates authority, execution boundaries, cognition, and trust.",
  "type": "object",
  "additionalProperties": true,

  "required": [
    "@config_id",
    "@version",
    "@law",
    "@environment",
    "@idb",
    "@atomic",
    "@mx2lex",
    "@dom_mask",
    "@data_sources",
    "@scxq2",
    "@constraints"
  ],

  "properties": {
    "@config_id": { "type": "string", "minLength": 1 },
    "@version": { "type": "string", "minLength": 1 },
    "@law": { "type": "string", "minLength": 1 },
    "@description": { "type": "string" },

    "@environment": {
      "type": "object",
      "description": "Environment modes replace scattered auth guards, role checks, and feature gates with one canonical truth.",
      "required": ["@modes", "@default", "@guest", "@authenticated", "@project"],
      "properties": {
        "@modes": {
          "type": "array",
          "items": { "type": "string", "enum": ["guest", "authenticated", "project"] },
          "minItems": 1
        },
        "@default": { "type": "string", "enum": ["guest", "authenticated", "project"] },
        "@guest": { "$ref": "#/$defs/envMode" },
        "@authenticated": { "$ref": "#/$defs/envMode" },
        "@project": { "$ref": "#/$defs/envMode" }
      },
      "additionalProperties": true
    },

    "@idb": {
      "type": "object",
      "description": "Persistence as law. Storage must exist, stores have declared purpose, encryption is explicit.",
      "required": ["@db_name", "@version", "@stores"],
      "properties": {
        "@db_name": { "type": "string", "minLength": 1 },
        "@version": { "type": "integer", "minimum": 1 },
        "@stores": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/idbStore" }
        }
      },
      "additionalProperties": true
    },

    "@atomic": {
      "type": "object",
      "description": "Atomic prefix and domain registration. Locks semantics into the system itself.",
      "required": ["@prefix", "@aliases", "@role", "@domains", "@rule"],
      "properties": {
        "@prefix": { "type": "string", "minLength": 1 },
        "@aliases": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "@role": { "type": "string" },
        "@domains": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "@rule": { "type": "string" }
      },
      "additionalProperties": true
    },

    "@atoms": {
      "type": "object",
      "description": "Each atom has glyph (symbolic), CSS (visual), XCFE (causal), AST (structural).",
      "additionalProperties": {
        "type": "object",
        "required": ["@glyph", "@css", "@xcfe", "@ast"],
        "properties": {
          "@glyph": { "type": "string", "minLength": 1 },
          "@css": { "type": "string", "minLength": 1 },
          "@xcfe": { "type": "string", "minLength": 1 },
          "@ast": { "type": "object" }
        },
        "additionalProperties": true
      }
    },

    "@glyphs": {
      "type": "object",
      "description": "Glyph registry with semantic meaning, domain, channels, and CSS variable binding.",
      "additionalProperties": {
        "type": "object",
        "required": ["@semantic", "@domain", "@channels", "@css_var"],
        "properties": {
          "@semantic": { "type": "string", "minLength": 1 },
          "@domain": { "type": "string", "minLength": 1 },
          "@channels": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "@css_var": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },

    "@mx2lex": {
      "type": "object",
      "description": "Language bidirectional infrastructure. Glyphs → words → AST → API translation.",
      "required": ["@enabled", "@direction", "@learning", "@maps"],
      "properties": {
        "@enabled": { "type": "boolean" },
        "@direction": {
          "type": "array",
          "items": { "type": "string", "enum": ["glyph", "word", "ast", "api"] },
          "minItems": 1
        },
        "@learning": { "type": "string" },
        "@maps": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      },
      "additionalProperties": true
    },

    "@dom_mask": {
      "type": "object",
      "description": "JS demotion by law. JS cannot define semantics, cannot mutate structure without AST.",
      "required": ["@authority", "@js_role", "@rules"],
      "properties": {
        "@authority": { "type": "string", "enum": ["ast_only"] },
        "@js_role": { "type": "string" },
        "@rules": {
          "type": "object",
          "required": ["js_cannot_define_semantics", "dom_changes_require_ast"],
          "properties": {
            "js_cannot_define_semantics": { "type": "boolean" },
            "dom_changes_require_ast": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },

    "@data_sources": {
      "type": "object",
      "description": "Memory sovereignty. Declares where data is allowed to exist.",
      "required": ["@local", "@cloud"],
      "properties": {
        "@local": { "type": "string" },
        "@cloud": {
          "type": "object",
          "properties": {
            "supabase": { "$ref": "#/$defs/cloudSource" },
            "mx2db": { "$ref": "#/$defs/cloudSource" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },

    "@scxq2": {
      "type": "object",
      "description": "Compression as first-class constraint. Required, targeted, measurable, loss-controlled.",
      "required": ["@enabled", "@targets", "@ratio_target", "@lossless"],
      "properties": {
        "@enabled": { "type": "boolean" },
        "@targets": {
          "type": "array",
          "items": { "type": "string", "enum": ["ast", "lexicon", "glyph_maps"] },
          "minItems": 1
        },
        "@ratio_target": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "@lossless": { "type": "boolean" }
      },
      "additionalProperties": true
    },

    "@constraints": {
      "type": "object",
      "description": "Explicit system ethics. Non-negotiable rules live here.",
      "required": ["@hard", "@soft"],
      "properties": {
        "@hard": { "type": "array", "items": { "type": "string" } },
        "@soft": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },

    "@routes": {
      "type": "object",
      "description": "Unified routing/linking system. Pages, APIs, includes are all links governed by config.",
      "properties": {
        "@pages": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/pageRoute" }
        },
        "@api": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/apiRoute" }
        },
        "@includes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/includeRoute" }
        }
      },
      "additionalProperties": true
    }
  },

  "$defs": {
    "envMode": {
      "type": "object",
      "required": ["@permissions", "@storage_scope", "@data_visibility"],
      "properties": {
        "@permissions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "@storage_scope": { "type": "string" },
        "@data_visibility": { "type": "string" }
      },
      "additionalProperties": true
    },

    "idbStore": {
      "type": "object",
      "required": ["@key", "@purpose", "@encrypted"],
      "properties": {
        "@key": { "type": "string", "minLength": 1 },
        "@purpose": { "type": "string", "minLength": 1 },
        "@encrypted": { "type": "boolean" },
        "@encryption": { "type": "string" }
      },
      "additionalProperties": true
    },

    "cloudSource": {
      "type": "object",
      "required": ["@role", "@contains"],
      "properties": {
        "@role": { "type": "string" },
        "@contains": { "type": "array", "items": { "type": "string" } },
        "@never_contains": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },

    "pageRoute": {
      "type": "object",
      "required": ["@type", "@link", "@mount"],
      "properties": {
        "@type": { "type": "string", "enum": ["page", "html"] },
        "@link": { "type": "string", "minLength": 1 },
        "@mount": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },

    "apiRoute": {
      "type": "object",
      "required": ["@type", "@link"],
      "properties": {
        "@type": { "type": "string", "enum": ["php", "gas", "rest"] },
        "@link": { "type": "string", "minLength": 1 },
        "@method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE"] }
      },
      "additionalProperties": true
    },

    "includeRoute": {
      "type": "object",
      "required": ["@type", "@link", "@mount"],
      "properties": {
        "@type": { "type": "string", "enum": ["html", "partial"] },
        "@link": { "type": "string", "minLength": 1 },
        "@mount": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
