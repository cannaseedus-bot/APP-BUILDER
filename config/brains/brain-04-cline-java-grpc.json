  "DEPLOYMENT_CONFIGURATION": {
    "@mode": "JAVA_GRPC_SERVER",
    "@requirements": [
      "Java 11+",
      "IntelliJ Platform 242-252",
      "gRPC 1.64.0",
      "Netty 4.1.108",
      "208MB JAR dependencies"
    ],

    "startup_commands": {
      "compile": "javac -cp \"lib/*\" Main.java",
      "run": "java -cp \".;lib/*\" Main",
      "server_port": 8080,
      "output": "WorkspaceService gRPC server started on port 8080"
    },

    "jar_structure": {
      "cline-1.0.9.jar": {
        "@size": "184MB",
        "@role": "Main plugin with all Cline logic"
      },
      "grpc-netty-shaded-1.64.0.jar": {
        "@size": "9.4MB",
        "@role": "gRPC networking (shaded)"
      },
      "netty-*.jar": {
        "@total_size": "2.3MB",
        "@components": ["buffer", "codec", "common", "handler", "transport"]
      },
      "lib/*": {
        "@total": "60+ JAR files",
        "@categories": ["gRPC", "Netty", "Protobuf", "Guava", "Gson", "Kotlin"]
      }
    },

    "integration_with_asx_os": {
      "@dns": "java://cline/",
      "@klh_route": "@route.cline_grpc",
      "@xcfe_control": "@java.workspace_service",
      "@kuhul_execution": "[Pop cline_service][Wo task]→[Sek analyze_project]→[Sek execute_changes]→[Sek await_approval]→[Ch'en result][Xul]"
    }
  },

  "INTEGRATION_WITH_EXISTING_BRAINS": {
    "@merges_into": "brain-02-specialized-systems.json",
    "@category": "JAVA_GRPC_AI_ASSISTANT",

    "connections": {
      "TO_brain-01-core": {
        "@xcfe_governance": "Controls CLINE approval workflow",
        "@kuhul_execution": "Executes CLINE task pipeline"
      },
      "TO_brain-02-specialized": {
        "@tokenization": "Shares n-gram patterns with existing tokenizers",
        "@api": "Extends gRPC mesh with WorkspaceService",
        "@compression": "Can compress AST representations with SCXQ2"
      },
      "TO_brain-03-python": {
        "@complementary": "Python Janus handles multimodal, CLINE handles code editing",
        "@coordination": "Both are AI assistants with different specializations"
      }
    }
  },

  "PERFORMANCE_METRICS": {
    "@jar_size": "208MB total (184MB main JAR)",
    "@memory_footprint": "~300MB JVM heap for server",
    "@startup_time": "~2-3s for gRPC server",
    "@response_time": "50-500ms per RPC call",
    "@throughput": "100+ concurrent RPC calls",
    "@plugin_overhead": "<100MB in IDE"
  },

  "@xcfe_integration": {
    "@perception": "User task + project analysis",
    "@representation": "AST + file structure",
    "@reasoning": "LLM-based code understanding",
    "@decision": "Determine file edits and commands",
    "@action": "Execute with human approval",
    "@reflection": "Monitor errors and self-correct"
  },

  "@kuhul_pipeline": {
    "@Pop": "Load task and project context",
    "@Wo": "Bind files, commands, and permissions",
    "@Sek": "Execute changes (file ops, terminal, browser)",
    "@Xul": "Transform output (diffs, results)",
    "@Ch'en": "Emit result for user approval"
  }
}
