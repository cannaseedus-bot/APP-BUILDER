      "AST_ANALYSIS",
      "LINTER_MONITORING",
      "ERROR_FIXING",
      "HUMAN_IN_LOOP",
      "AI_ASSISTANT",
      "CODE_EDITING",
      "COMMAND_EXECUTION",
      "SCREENSHOT_CAPTURE",
      "CONTEXT_MANAGEMENT",
      "PROJECT_ANALYSIS",
      "DIFF_EDITOR",
      "INTENTION_ACTION",
      "APPROVAL_GATE"
    ],

    "@trigrams": [
      "WORKSPACE_SERVICE_GRPC",
      "INTELLIJ_PLUGIN_INTEGRATION",
      "FILE_EDIT_MONITOR",
      "TERMINAL_COMMAND_EXECUTE",
      "BROWSER_HEADLESS_CAPTURE",
      "AST_PARSE_ANALYZE",
      "HUMAN_IN_LOOP_APPROVAL",
      "AI_AGENT_ASSISTANT"
    ],

    "vocabulary_cline": {
      "@size": 93,
      "@tokens": {
        "CLINE": 0,
