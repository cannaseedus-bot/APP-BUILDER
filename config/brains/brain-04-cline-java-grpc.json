{
  "@manifest": "CLINE_JAVA_GRPC_AI_ASSISTANT_BRAIN",
  "@version": "Ω.4.0.0",
  "@created": "2025-12-09T07:40:00.000Z",
  "@law": "ASX = XCFE = JAVA = CLINE = GRPC = AI_AGENT",
  "@purpose": "CLINE AI coding assistant: Java-based gRPC backend with IntelliJ IDE integration",

  "@summary": {
    "model": "Frontier LLMs (OpenAI, Anthropic, etc.)",
    "framework": "Java + gRPC + Netty + IntelliJ Platform",
    "capabilities": ["file_operations", "terminal_execution", "browser_automation", "ast_analysis", "linter_monitoring"],
    "architecture": "Human-in-the-loop agentic AI",
    "version": "1.0.9",
    "total_size": "208MB (JAR files + dependencies)"
  },

  "CLINE_ARCHITECTURE": {
    "@role": "AI_CODING_ASSISTANT_WITH_CLI_AND_EDITOR_ACCESS",
    "@plugin_id": "bot.cline",
    "@vendor": "Cline",
    "@ide_support": ["IntelliJ IDEA", "WebStorm", "Rider", "All JetBrains IDEs"],

    "CORE_CAPABILITIES": {
      "file_operations": {
        "@create_files": "Generate new source files",
        "@edit_files": "Modify existing files with AST awareness",
        "@read_files": "Analyze file structure and content",
        "@monitor_errors": "Track linter/compiler errors in real-time",
        "@proactive_fixes": "Auto-fix imports, syntax errors"
      },

      "terminal_execution": {
        "@run_commands": "Execute shell commands with permission",
        "@monitor_output": "Track command output and errors",
        "@react_to_errors": "Respond to dev server issues",
        "@dev_workflows": "Start servers, run tests, build projects"
      },

      "browser_automation": {
        "@headless_browser": "Launch sites in headless mode",
        "@interact": "Click, type, scroll",
        "@capture": "Screenshots + console logs",
        "@debug": "Fix runtime errors and visual bugs"
      },

      "project_analysis": {
        "@ast_parsing": "Analyze source code Abstract Syntax Trees",
        "@regex_search": "Pattern-based code search",
        "@file_structure": "Understand project organization",
        "@context_management": "Smart context window optimization"
      },

      "model_context_protocol": {
        "@mcp_support": "Create new tools via MCP",
        "@self_extension": "Extend own capabilities",
        "@tool_creation": "Dynamic tool generation"
      }
    },

    "GRPC_BACKEND": {
      "@service": "WorkspaceServiceGrpc",
      "@port": 8080,
      "@protocol": "gRPC over Netty",
      "@methods": [
        "getDiagnostics",
        "createFile",
        "editFile",
        "readFile",
        "executeCommand",
        "monitorOutput",
        "launchBrowser",
        "captureScreenshot"
      ],

      "server_configuration": {
        "@builder": "NettyServerBuilder",
        "@implementation": "WorkspaceServiceImplBase",
        "@startup": "java -cp \".;lib/*\" Main",
        "@ast_format": "[Pop start_grpc_server][Wo port_8080]→[Sek netty_builder]→[Sek add_workspace_service]→[Sek build_start]→[Ch'en server_running][Xul]"
      },

      "dependencies": {
        "grpc": {
          "@version": "1.64.0",
          "@components": ["grpc-netty", "grpc-netty-shaded", "grpc-stub", "grpc-services"]
        },
        "netty": {
          "@version": "4.1.108.Final",
          "@components": ["buffer", "codec", "common", "handler", "transport"]
        },
        "protobuf": {
          "@version": "3.25.1",
          "@format": "Protocol Buffers for RPC"
        },
        "guava": {
          "@version": "32.1.3-jre",
          "@role": "Collections and utilities"
        },
        "gson": {
          "@version": "2.10.1",
          "@role": "JSON serialization"
        },
        "kotlin": {
          "@version": "1.8.0",
          "@components": ["stdlib", "stdlib-jdk7", "stdlib-jdk8"]
        }
      }
    },

    "INTELLIJ_PLUGIN_INTEGRATION": {
      "@plugin_type": "JetBrains IntelliJ Platform",
      "@since_build": "242",
      "@until_build": "252.*",

      "tool_window": {
        "@id": "Cline",
        "@factory": "ClineToolWindowFactory",
        "@icon": "clineLogo13x13.svg",
        "@location": "Right sidebar"
      },

      "actions": {
        "AddToClineAction": {
          "@text": "Add to Cline",
          "@description": "Send selected code to Cline",
          "@group": "EditorPopupMenu",
          "@anchor": "first"
        },
        "FixWithClineAction": {
          "@type": "IntentionAction",
          "@trigger": "Fix selected code with AI"
        },
        "ExplainWithClineAction": {
          "@type": "IntentionAction",
          "@trigger": "Explain code with AI"
        },
        "ImproveWithClineAction": {
          "@type": "IntentionAction",
          "@trigger": "Improve code with AI"
        },
        "FocusToolWindowAction": {
          "@shortcut": "Ctrl+Quote",
          "@description": "Focus Cline tool window"
        }
      },

      "startup_activity": {
        "@class": "ClineProjectActivity",
        "@trigger": "postStartup",
        "@initialization": "Connect to gRPC backend on project open"
      },

      "diff_editor": {
        "@provider": "ClineDiffFileEditorProvider",
        "@role": "Show AI-suggested changes with diff view"
      },

      "notifications": {
        "@group": "Cline Messages",
        "@display_type": "BALLOON",
        "@resource_bundle": "ClineBundle.properties"
      }
    },

    "WORKFLOW_PIPELINE": {
      "@human_in_loop": "All actions require user approval",
      "@safety": "Sandboxed with permission gates",

      "task_execution_flow": {
        "1_receive_task": {
          "@input": "User enters task + optional images",
          "@examples": ["Convert mockup to app", "Fix bug from screenshot"]
        },
        "2_analyze_project": {
          "@actions": [
            "Parse file structure",
            "Analyze source code ASTs",
            "Run regex searches",
            "Read relevant files"
          ],
          "@context_optimization": "Smart context window management"
        },
        "3_execute_changes": {
          "@file_operations": "Create/edit with error monitoring",
          "@terminal_commands": "Run with output tracking",
          "@browser_testing": "Launch and debug web apps"
        },
        "4_present_result": {
          "@output": "Terminal command to view result",
          "@example": "open -a \"Google Chrome\" index.html",
          "@approval": "User clicks to execute"
        }
      },

      "ast_format": "[Pop receive_task][Wo task_description images]→[Sek analyze_project]→[Sek parse_ast]→[Sek read_files]→[Sek execute_changes]→[Sek monitor_errors]→[Sek fix_issues]→[Ch'en task_complete][Xul]"
    }
  },

  "CLINE_TOKENIZATION": {
    "@name": "@-GRAMS_CLINE_JAVA",

    "@unigrams": [
