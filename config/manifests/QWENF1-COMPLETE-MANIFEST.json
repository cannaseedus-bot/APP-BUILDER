        "optimizer_url": "https://mx2lm.app/QwenF1/checkpoint-100/optimizer.pt",
        "fold_id": "fold_recovery_v1",
        "start_step": 100
      }
    },

    "scenario_3_fine_tune": {
      "description": "Fine-tune without optimizer (start fresh)",
