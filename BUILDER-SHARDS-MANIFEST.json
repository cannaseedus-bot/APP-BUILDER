    "@principle": "ONE BUILDER = ONE SHARD",
    "@deployment": "Google Apps Script Web Apps",
    "@communication": "REST mesh with XJSON payloads",
    "@orchestration": "MX2LM coordinates all builder shards",

    "total_shards": 9,
