      "@name": "SCX Advanced Compressor Shard",
      "@status": "PENDING_DEPLOYMENT",
      "@endpoint": "https://script.google.com/macros/s/[DEPLOY_SCX_COMPRESSOR_SHARD]/exec",
      "@description": "Multi-algorithm compression with SCXQ2 semantic optimization",

      "builder_type": "compressor",
      "specialization": "semantic_compression",
      "algorithms": ["SCXQ2", "dictionary", "symbolic", "huffman", "quantum_optimized"],

      "capabilities": [
