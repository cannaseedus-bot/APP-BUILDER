  "🔗SHARD_MESH_COMMUNICATION": {
    "@protocol": "REST over HTTPS",
    "@format": "XJSON payloads",
    "@authentication": "Google Apps Script built-in",

    "request_format": {
      "action": "string (required)",
      "payload": "object (varies by shard)",
      "session_id": "string (optional)",
      "callback_url": "string (optional for async)"
    },

    "response_format": {
      "ok": "boolean",
      "data": "object (shard-specific)",
      "error": "string (if ok=false)",
      "shard_id": "string",
      "timestamp": "ISO 8601",
      "execution_time_ms": "number"
    },

    "error_handling": {
      "timeout": "30000ms default, configurable per shard",
      "retry_attempts": 3,
      "backoff_strategy": "exponential (2s, 4s, 8s)",
      "fallback": "local_browser_execution"
    }
  },

  "🚀DEPLOYMENT_GUIDE": {
    "@platform": "Google Apps Script",
    "@deployment_type": "Web App",

    "steps": [
      "1. Create new Google Apps Script project for each builder",
      "2. Implement doPost(e) handler with builder logic",
      "3. Deploy as Web App (Execute as: Me, Access: Anyone)",
      "4. Copy deployment URL to this manifest",
      "5. Update builder UI to use new shard endpoint",
      "6. Test with example payloads",
      "7. Monitor performance and update MX2LM routing"
    ],

    "deployment_template": {
      "file": "gas-shard-template.js",
      "description": "Reusable template for all builder shards"
    }
  },

  "📊MONITORING": {
    "metrics_tracked": [
