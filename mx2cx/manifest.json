{
  "立v": "1.0.0",
  "n": "ASX_BUILDER_CODEX_ATOMIC_GUIDE",
  "d": "Micro-ASXR Builder Codex: atomic guide UI for research, template forge, stack manager, agent forge, and RLHF visualizer wired to the AI CMS mesh.",
  "timestamp": 1890000012000,

  "mode": "micro-asxr-builder",
  "shard": {
    "id": "builder_codex",
    "role": "ai_cms_builder_codex",
    "mesh_group": "cms-backbone",
    "visibility": "local-shell"
  },

  "runtime_binding": {
    "index.html": "BUILDER_ATOMIC_GUIDE_UI",
    "sw.js": "BUILDER_MICRO_ASXR_KERNEL",
    "manifest.json": "BUILDER_CODEX_LAW"
  },

  "kuhul_folds": {
    "ai":        { "status": "active",   "role": "builder.assistant" },
    "ui":        { "status": "active",   "role": "atomic_guide_shell" },
    "runtime":   { "status": "active",   "role": "micro_asxr_kernel" },
    "storage":   { "status": "active",   "role": "asx_ram_keys" },
    "network":   { "status": "active",   "role": "mesh_rest_proxy" },
    "trainer":   { "status": "active",   "role": "rlhf_interface" },
    "security":  { "status": "active",   "role": "api_policy_guard" },
    "atomic":    { "status": "active",   "role": "atomic_css_layout" },
    "tapes":     { "status": "active",   "role": "builder_tapes" },
    "cms":       { "status": "active",   "role": "ai_cms_backbone_link" },
    "rlhf":      { "status": "active",   "role": "feedback_stream" },
    "debug":     { "status": "passive",  "role": "dev_logging" }
  },

  "atomic": {
    "theme": {
      "name": "hazard-gold-ghost",
      "accent_primary": "#ffd000",
      "accent_secondary": "#16f2aa",
      "bg": "#020409",
      "panel": "#050a14"
    },
    "layout": {
      "shell": "atomic_guide_v1",
      "regions": ["sidebar_tapes", "main_view"],
      "nav_selection_model": "tape-id"
    }
  },

  "asx_ram": {
    "namespace": "builder_codex",
    "keys": {
      "builder.last_query": { "ttl": 86400000 },
      "builder.last_stack": { "ttl": 86400000 },
      "builder.mesh_base":  { "ttl": 604800000 },
      "builder.agent_state": { "ttl": 3600000 },
      "builder.rlhf.metrics.cache": { "ttl": 600000 }
    }
  },

  "rest_mesh": {
    "mesh_base_default": "https://api.asxtoken.com",
    "mesh_header_shard": "builder_codex",
    "namespaces": {
      "builder": "/builder",
      "rlhf": "/rlhf",
      "cms": "/cms"
    },
    "endpoints": {
      "builder.research": {
        "local_path": "/api/builder/research",
        "mesh_path": "/builder/research",
        "method": "POST"
      },
      "builder.template.build": {
        "local_path": "/api/builder/template/build",
        "mesh_path": "/builder/template/build",
        "method": "POST"
      },
      "builder.template.stack": {
        "local_path": "/api/builder/template/stack",
        "mesh_path": "/builder/template/stack",
        "method": "POST"
      },
      "builder.agent.create": {
        "local_path": "/api/builder/agent/create",
        "mesh_path": "/builder/agent/create",
        "method": "POST"
      },
      "rlhf.metrics": {
        "local_path": "/api/rlhf/metrics",
        "mesh_path": "/rlhf/metrics",
        "method": "GET"
      },
      "builder.chat": {
        "local_path": "/api/builder/chat",
        "mesh_path": "/builder/chat",
        "method": "POST"
      }
    }
  },

  "asxr": {
    "id": "builder_codex_asxr",
    "role": "builder_cms_research_station",
    "tapes": {
      "research": {
        "id": "builder_research",
        "label": "Research",
        "route": "/api/builder/research",
        "method": "POST",
        "rest_mesh_key": "builder.research"
      },
      "template_forge": {
        "id": "builder_template_forge",
        "label": "Template Forge",
        "route": "/api/builder/template/build",
        "method": "POST",
        "rest_mesh_key": "builder.template.build"
      },
      "stack_manager": {
        "id": "builder_stack_manager",
        "label": "Stack Manager",
        "route": "/api/builder/template/stack",
        "method": "POST",
        "rest_mesh_key": "builder.template.stack"
      },
      "agent_forge": {
        "id": "builder_agent_forge",
        "label": "Agent Forge",
        "route": "/api/builder/agent/create",
        "method": "POST",
        "rest_mesh_key": "builder.agent.create"
      },
      "rlhf_visualizer": {
        "id": "builder_rlhf_visualizer",
        "label": "RLHF Visualizer",
        "route": "/api/rlhf/metrics",
        "method": "GET",
        "rest_mesh_key": "rlhf.metrics"
      },
      "chat": {
        "id": "builder_chat",
        "label": "AI Assistant",
        "route": "/api/builder/chat",
        "method": "POST",
        "rest_mesh_key": "builder.chat"
      }
    }
  },

  "agents": {
    "profile.manager": {
      "id": "agent.profile.manager",
      "role": "user_profile_layout_and_prefs",
      "targets": ["cms.users", "asx_ram"],
      "routes": {
        "saveProfile": "/cms/profile/save",
        "loadProfile": "/cms/profile/get"
      }
    },
    "memory.trainer": {
      "id": "agent.memory.trainer",
      "role": "ngram_builder_and_heatmap_source",
      "targets": ["asx_ram", "rlhf.stream"],
      "routes": {
        "pushExample": "/cms/memory/push",
        "getHeatmap": "/cms/memory/heatmap"
      }
    },
    "rlhf.reinforcer": {
      "id": "agent.rlhf.reinforcer",
      "role": "feedback_scorer_and_bridge_to_trainer",
      "targets": ["rlhf.metrics", "trainer"],
      "routes": {
        "submitScore": "/rlhf/score/submit",
        "getMetrics": "/rlhf/metrics"
      }
    }
  },

  "security": {
    "allow_mesh_override_from_ui": true,
    "allowed_mesh_protocols": ["https", "http"],
    "headers": {
      "X-ASX-Shard": "builder_codex",
      "X-ASX-Mode": "builder"
    }
  },

  "health": {
    "check_local": "/health",
    "check_mesh": "/cms/health",
    "expected": {
      "status": "ok"
    }
  }
}
