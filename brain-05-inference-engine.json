        {"token": "EMBED", "weight": 0.88},
        {"token": "ATTENTION", "weight": 0.86},
        {"token": "CONTEXT", "weight": 0.84},
        {"token": "STREAM", "weight": 0.82},
        {"token": "MULTIMODAL", "weight": 0.80}
      ],

      "@workflow_transitions": {
        "PROMPT→TOKEN": 0.95,
        "TOKEN→COMPRESS": 0.93,
        "COMPRESS→CONTEXT": 0.91,
        "CONTEXT→EMBED": 0.94,
        "EMBED→ATTENTION": 0.92,
        "ATTENTION→TRANSFORM": 0.93,
        "TRANSFORM→GENERATE": 0.90,
