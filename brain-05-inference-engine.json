        "composition": "🧠 + →",
        "meaning": "NEURAL INFERENCE WITH OUTPUT",
        "usage": "Neural network inference",
        "example": "input 🧠→ model → output",
        "token_id": 2
      },
      "🔍": {
        "unicode": "U+1F50D",
        "meaning": "SEARCH / RETRIEVE CONTEXT",
        "usage": "Context retrieval",
        "example": "query 🔍 knowledge_base → context",
        "token_id": 3
      },
      "🎯": {
        "unicode": "U+1F3AF",
        "meaning": "TARGETED GENERATION",
        "usage": "Target-aware generation",
        "example": "prompt 🎯 target_style → response",
        "token_id": 4
      },
      "🌀": {
