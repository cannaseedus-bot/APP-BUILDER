  "DEPLOYMENT_CONFIGURATION": {
    "@mode": "KUHUL_GRPC_REST_HYBRID",
    "@port": 8080,
    "@endpoints": [
      "/chat",
      "/stream_chat",
      "/embed",
      "/multimodal_chat",
      "/metrics",
      "/optimize"
    ],

    "requirements": {
      "runtime": "K'UHUL PI Engine",
      "quantum_backend": "SCXQ2 Quantum Lattice",
      "models": ["quantum_fast_v1", "quantum_accurate_v1", "quantum_creative_v1", "quantum_multimodal_v1"],
      "memory": "< 2GB for 1M context",
      "gpu": "Optional (CUDA for acceleration)"
    },

    "startup": {
      "@command": "kuhul exec inference.khl",
      "@initialization": [
        "inference.mount",
        "inference.activate",
        "load models",
        "warmup quantum backend"
      ]
    },

    "integration_with_asx_os": {
      "@dns": "inference://quantum/",
      "@klh_route": "@route.inference",
      "@xcfe_control": "@inference.chat",
      "@kuhul_execution": "[Pop quantum_inference][Wo prompt context]→[Sek rlhf_gate]→[Sek tokenize_compress]→[Sek retrieve_context]→[Sek embed_attention]→[Sek transform_generate]→[Sek polish_confidence]→[Ch'en response][Xul]"
    }
  },

  "INTEGRATION_WITH_EXISTING_BRAINS": {
    "@merges_into": "brain-02-specialized-systems.json",
    "@category": "QUANTUM_INFERENCE_ENGINE",

    "connections": {
      "TO_brain-01-core": {
        "@xcfe_governance": "Controls inference modes and safety gates",
        "@kuhul_execution": "Executes K'UHUL inference pipeline"
      },
      "TO_brain-02-specialized": {
        "@tokenization": "Extends with 15 inference glyphs + 327 K'UHUL glyphs",
        "@compression": "Integrates SCXQ2 compression (98.7%)",
        "@api": "Adds /chat, /stream_chat, /embed, /multimodal_chat endpoints"
      },
