{
  "@context": "xjson://assoc/creative_stack/v1",
  "@n": "ASSOCIATION_PACK_WEB_APP_GAME_ATOMIC",
  "@d": "Word-association clusters for websites, apps, games, builders, designers, UI, math, science, theory, atomic ASX blocks, and the ASX stack.",
  "@version": "1.0.0",

  "clusters": {
    "websites": {
      "nouns": ["site","page","layout","section","header","footer","navigation","menu","link","content","article","blog","landing","dashboard","portal"],
      "verbs": ["browse","scroll","click","navigate","load","render","deploy","publish","update","optimize"],
      "concepts": ["responsive","interactive","static","dynamic","accessible","fast","lightweight","minimal","immersive"]
    },

    "apps": {
      "nouns": ["app","screen","module","feature","workflow","notification","session","profile","settings","dashboard","widget"],
      "verbs": ["tap","swipe","launch","install","update","sync","authenticate","configure","share"],
      "concepts": ["mobile","native","hybrid","offline-first","real-time","user-centric","performant"]
    },

    "games": {
